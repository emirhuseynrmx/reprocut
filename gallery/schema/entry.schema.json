{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocut.dev/schemas/gallery-entry-v1.json",
  "title": "ReproCut gallery entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "title",
    "license",
    "ecosystem",
    "fingerprint_sha256",
    "termination",
    "original_files",
    "retained_files",
    "original_bytes",
    "retained_bytes",
    "source_included",
    "featured"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "license": { "type": "string", "minLength": 1, "maxLength": 100 },
    "ecosystem": { "enum": ["cargo", "python", "npm", "none"] },
    "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "termination": { "type": "string", "minLength": 1, "maxLength": 80 },
    "original_files": { "type": "integer", "minimum": 1 },
    "retained_files": { "type": "integer", "minimum": 1 },
    "original_bytes": { "type": "integer", "minimum": 1 },
    "retained_bytes": { "type": "integer", "minimum": 1 },
    "source_included": { "type": "boolean" },
    "featured": { "type": "boolean" }
  }
}
